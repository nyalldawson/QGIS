        virtual void visit( const NodeForEach &n );

        virtual void visit( const NodeWhile &n );

        virtual void visit( const NodeDo &n );

        virtual void visit( const NodeWith &n );

        virtual void visit( const NodeExit & );
        virtual void visit( const NodeOnError & );
        virtual void visit( const NodeSubDef &n );

        virtual void visit( const NodeFuncDef &n );

        virtual void visit( const NodePropDef &n );

